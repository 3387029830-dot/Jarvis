{
  "name": "jarvis-cognition",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first personal cognition desktop application",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jarvis/desktop dev",
    "build": "pnpm --filter @jarvis/desktop build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter @jarvis/desktop typecheck",
    "test": "pnpm --filter @jarvis/desktop test",
    "smoke": "pnpm --filter @jarvis/desktop smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
