    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "jsdom": "29.1.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
